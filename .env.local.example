# URL del backend (BajaNews.Api). Sin prefijo NEXT_PUBLIC_ a propósito:
# el navegador nunca debe saber esta URL, solo el servidor de Next.js
# (ver lib/backend.ts).
BACKEND_URL=http://localhost:5000

# Esta SÍ es pública: solo se usa para construir <img src="..."> hacia
# archivos subidos (fotos de portada, logos de clientes, etc.), que el
# backend sirve sin autenticación. Normalmente es la misma URL que
# BACKEND_URL, pero queda separada por claridad (ver lib/assets.ts).
NEXT_PUBLIC_ASSET_URL=http://localhost:5000

# URL del sitio público (xolos-noticias), para el link "Sitio Web" del menú.
# Con NEXT_PUBLIC_ porque el menú es un componente de cliente.
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000
